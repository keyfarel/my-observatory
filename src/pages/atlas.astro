---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/ui/Navbar.astro';
import Map from '../components/constellation/Map';
import { CONSTELLATIONS } from '../utils/astronomy';

// Generate mock projects for each supported constellation size (4 to 10)
const generateMockProjects = (count: number) => {
  return Array.from({ length: count }, (_, i) => ({
    id: `mock-project-${count}-${i}`,
    slug: `mock-project-${count}-${i}`,
    data: { 
      title: `Project ${i + 1}`, 
      domain: 'Sample Domain' 
    }
  }));
};

const constellationSizes = Object.keys(CONSTELLATIONS).map(Number).sort((a, b) => a - b);

const seo = {
  title: 'Constellation Atlas | Key Firdausi Al Farel',
  description: 'An interactive atlas of constellations representing the project structure.'
};
---

<Layout seo={seo}>
  <div class="min-h-screen flex flex-col">
    <Navbar />
    
    <main class="flex-grow w-full px-6 py-12">
      <header class="mb-16 max-w-4xl mx-auto text-center">
        <div class="font-mono text-solar-gold text-xs tracking-[0.3em] uppercase mb-4">
          SYSTEM DIAGNOSTICS
        </div>
        <h1 class="font-display font-light text-4xl text-starlight mb-2">CONSTELLATION ATLAS</h1>
        <p class="font-mono text-xs text-muted-star uppercase tracking-widest">Internal view of all normalized J2000 mappings</p>
      </header>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-[1400px] mx-auto">
        {constellationSizes.map(size => {
          const mockProjects = generateMockProjects(size);
          const name = CONSTELLATIONS[size].name;
          
          return (
            <div class="flex flex-col">
              <div class="font-mono text-sm text-starlight tracking-widest uppercase mb-4 flex justify-between border-b border-muted-star/20 pb-2">
                <span>{size} PROJECTS</span>
                <span class="text-solar-gold">{name}</span>
              </div>
              {/* Force the map height to be smaller for the grid view */}
              <div class="w-full h-[400px]">
                <Map client:load projects={mockProjects} />
              </div>
            </div>
          );
        })}
      </div>
    </main>
  </div>
</Layout>
