---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import Starfield from '../../components/ui/Starfield.astro';

export function getStaticPaths() {
  const experiments = [
    {
      id: '014',
      title: 'ESP32 RELAY CONTROL',
      domain: 'Hardware / ESP32',
      status: 'COMPLETED',
      overview: 'Controlled a 5V relay module using ESP32 GPIO pins. Investigated isolation between the low-voltage control circuit and the high-voltage load circuit.',
      result: 'Relay successfully switches between HIGH / LOW states via web interface. Measured 12ms switching delay. No significant noise observed on the 3.3V rail during switching.',
      stack: ['ESP32', 'Arduino C++', '5V Relay Module', 'WebSockets'],
      source: 'https://github.com',
      photoLabel: '[ BREADBOARD & RELAY WIRING ]',
      logs: [
        { time: '14:32:01.045', text: '> ESP32 Booting...' },
        { time: '14:32:01.120', text: '> Connecting to WiFi...' },
        { time: '14:32:03.450', text: '> Connected! IP: 192.168.1.45' },
        { time: '14:32:03.500', text: '> Init GPIO 4 as OUTPUT' },
        { time: '14:32:05.000', text: '> Relay: HIGH' },
        { time: '14:32:06.000', text: '> Relay: LOW' }
      ]
    },
    {
      id: '013',
      title: 'MQTT COMMUNICATION',
      domain: 'IoT / Networking',
      status: 'ONGOING',
      overview: 'Setting up a local Mosquitto MQTT broker on a Raspberry Pi and testing QoS 0 vs QoS 1 latency across a saturated local network.',
      result: 'Average latency under load is 15ms for QoS 0 and 42ms for QoS 1. Handshake overhead significantly impacts low-power devices awake time.',
      stack: ['Mosquitto', 'Raspberry Pi', 'Python', 'Paho MQTT'],
      source: 'https://github.com',
      photoLabel: '[ RASPBERRY PI BROKER SETUP ]',
      logs: [
        { time: '09:12:00.001', text: '> mosquitto -c /etc/mosquitto.conf' },
        { time: '09:12:00.050', text: '> IPv4 listen on port 1883' },
        { time: '09:12:45.220', text: '> New client connected: esp32_node_01' },
        { time: '09:12:45.300', text: '> Subscribe topic /home/sensors QoS 1' },
        { time: '09:13:02.100', text: '> PUBLISH /home/sensors {"temp":24.5}' },
        { time: '09:13:02.115', text: '> PUBACK received (15ms)' }
      ]
    },
    {
      id: '012',
      title: 'PLC FUNDAMENTALS',
      domain: 'Industrial Automation',
      status: 'ARCHIVED',
      overview: 'Basic ladder logic programming and I/O mapping using a simulated PLC environment for motor start/stop control circuits.',
      result: 'Successfully simulated self-holding circuits and interlocks. Realized the conceptual similarity between PLC scan cycles and standard microcontroller main loops.',
      stack: ['OpenPLC', 'Ladder Logic', 'Modbus TCP'],
      source: null,
      photoLabel: '[ LADDER LOGIC SCHEMATIC ]',
      logs: [
        { time: '11:05:22.000', text: '> OpenPLC Runtime starting...' },
        { time: '11:05:22.450', text: '> Compiling program logic.st' },
        { time: '11:05:24.100', text: '> Optimization complete. 0 Errors.' },
        { time: '11:05:24.200', text: '> Modbus TCP server listening on :502' },
        { time: '11:06:10.050', text: '> Modbus Client connected (127.0.0.1)' },
        { time: '11:06:12.000', text: '> COIL 0x01 written: TRUE (Motor RUN)' }
      ]
    },
    {
      id: '011',
      title: 'PHONE HARDWARE',
      domain: 'Electronics / Repair',
      status: 'COMPLETED',
      overview: 'Teardown and logic board diagnosis of a dead smartphone. Tracing the power delivery sequence from the battery connector to the PMIC.',
      result: 'Identified a shorted capacitor near the main PMIC. Injected 1V to find the thermal hot spot. Replacing the 0402 cap restored normal boot sequences.',
      stack: ['Multimeter', 'Thermal Camera', 'Micro-Soldering', 'Schematics'],
      source: null,
      photoLabel: '[ LOGIC BOARD MACRO SHOT ]',
      logs: [
        { time: '16:20:00.000', text: '> Connecting DC Power Supply...' },
        { time: '16:20:05.000', text: '> Voltage set: 4.2V, Max Current: 2A' },
        { time: '16:20:10.500', text: '> V_BATT connected. Current draw: 0.8A' },
        { time: '16:20:10.550', text: '> WARNING: Unusually high standby current' },
        { time: '16:25:00.000', text: '> Thermal sweep: 45°C detected at C402' },
        { time: '16:40:00.000', text: '> Component replaced. Standby: 0.002A (OK)' }
      ]
    }
  ];

  return experiments.map((exp) => ({
    params: { id: exp.id },
    props: { data: exp },
  }));
}

const { id } = Astro.params;
const { data } = Astro.props;

const seo = {
  title: `Experiment ${id} — ${data.title}`,
  description: data.overview,
};
---

<Layout seo={seo}>
  <Starfield />
  <Navbar />
  
  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 py-32">
    
    <a href="/#laboratory" class="inline-flex items-center gap-2 font-mono text-xs text-muted-star hover:text-solar-gold transition-colors mb-16 uppercase tracking-widest">
      <span class="text-[14px]">←</span> BACK TO LABORATORY
    </a>

    <header class="mb-12">
      <div class="font-mono text-solar-gold text-xs tracking-widest mb-4">
        EXPERIMENT {id}
      </div>
      <h1 class="font-display font-light text-4xl md:text-6xl text-starlight mb-4 uppercase tracking-tight">
        {data.title}
      </h1>
      <div class="font-mono text-sm text-muted-star">
        {data.domain}
      </div>
    </header>

    <div class="mb-16">
      <div class={`inline-flex items-center gap-2 font-mono text-xs px-4 py-2 border ${data.status === 'COMPLETED' ? 'border-starlight/20 text-starlight' : data.status === 'ONGOING' ? 'border-solar-gold/30 text-solar-gold' : 'border-muted-star/20 text-muted-star'} uppercase tracking-widest rounded-sm`}>
        {data.status === 'ONGOING' && <span class="w-1.5 h-1.5 rounded-full bg-solar-gold animate-pulse"></span>}
        {data.status === 'COMPLETED' && <span class="w-1.5 h-1.5 rounded-full bg-starlight"></span>}
        {data.status}
      </div>
    </div>

    {/* SPLIT GRID LAYOUT */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pt-8 border-t border-muted-star/10">
      
      {/* LEFT COLUMN: CONTEXT (5 columns) */}
      <div class="lg:col-span-5 space-y-12">
        {/* OVERVIEW */}
        <section>
          <h2 class="font-mono text-[10px] text-muted-star/50 uppercase tracking-widest mb-4">OVERVIEW</h2>
          <p class="font-sans text-starlight text-base leading-relaxed">
            {data.overview}
          </p>
        </section>

        {/* RESULT */}
        <section>
          <h2 class="font-mono text-[10px] text-muted-star/50 uppercase tracking-widest mb-4">RESULT</h2>
          <p class="font-sans text-muted-star text-sm leading-relaxed">
            {data.result}
          </p>
        </section>

        {/* STACK */}
        <section>
          <h2 class="font-mono text-[10px] text-muted-star/50 uppercase tracking-widest mb-4">STACK</h2>
          <div class="flex flex-wrap gap-2">
            {data.stack.map(tech => (
              <span class="inline-block px-3 py-1.5 bg-deep-space border border-muted-star/20 font-mono text-[10px] text-starlight uppercase tracking-wider rounded-sm">
                {tech}
              </span>
            ))}
          </div>
        </section>

        {/* SOURCE */}
        {data.source && (
          <section>
            <h2 class="font-mono text-[10px] text-muted-star/50 uppercase tracking-widest mb-4">SOURCE</h2>
            <a href={data.source} target="_blank" class="inline-flex items-center gap-2 font-mono text-sm text-starlight hover:text-solar-gold transition-colors group">
              GitHub Repository <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </section>
        )}
      </div>

      {/* RIGHT COLUMN: EVIDENCE (7 columns) */}
      <div class="lg:col-span-7 space-y-6">
        <h2 class="font-mono text-[10px] text-muted-star/50 uppercase tracking-widest mb-4">EVIDENCE</h2>
        
        {/* HARDWARE PHOTO */}
        <div class="aspect-video w-full bg-deep-space/30 border border-muted-star/20 rounded-md flex items-center justify-center relative overflow-hidden group">
          {/* Subtle blueprint grid background */}
          <div class="absolute inset-0 bg-[linear-gradient(rgba(126,137,152,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(126,137,152,0.05)_1px,transparent_1px)] bg-[size:20px_20px]"></div>
          
          <div class="font-mono text-xs text-muted-star flex items-center gap-2 z-10">
             <span>{data.photoLabel}</span>
          </div>
        </div>
        
        {/* SERIAL LOG TERMINAL */}
        <div class="w-full bg-[#050505] border border-muted-star/20 rounded-md p-6 font-mono text-xs text-[#22c55e]/90 overflow-hidden relative shadow-inner">
          <div class="absolute top-4 right-4 text-muted-star/30 text-[9px] tracking-widest uppercase">
             [ SERIAL LOG ]
          </div>
          
          <div class="opacity-90 font-mono space-y-1.5 mt-2">
            {data.logs.map((log) => (
              <div><span class="text-muted-star/50 mr-2">[{log.time}]</span>{log.text}</div>
            ))}
            <div class="flex items-center pt-2"><span class="text-muted-star/50 mr-2">[{data.logs[data.logs.length - 1].time.replace(/\d\d$/, '12')}]</span>&gt; <span class="inline-block w-2 h-4 bg-[#22c55e] animate-pulse ml-1"></span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
