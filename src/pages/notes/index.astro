---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sortedNotes = notes.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const seo = {
  title: 'Observation Log | Key Firdausi Al Farel',
  description: 'Brain dumps, engineering notes, and unstructured thoughts.'
};
---

<Layout seo={seo}>
  <Navbar />
  
  <main class="max-w-6xl mx-auto px-6 lg:px-12 pt-32 pb-48 relative z-10">
    <a href="/#observation-log" class="inline-flex items-center group font-mono text-xs text-muted-star hover:text-solar-gold transition-colors tracking-widest uppercase mb-12 animate-fade-in">
      <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1.5 mr-2">←</span> HOME
    </a>
    
    <header class="mb-24 animate-fade-in">
      <h1 class="font-display font-light text-5xl md:text-7xl text-starlight mb-6 uppercase tracking-tight">OBSERVATION LOG</h1>
      <p class="font-mono text-sm text-muted-star uppercase tracking-widest max-w-xl leading-relaxed">
        Brain dumps, engineering notes, and unstructured thoughts. Maintained sporadically.
      </p>
    </header>

    <div class="space-y-6">
      {sortedNotes.map((note, i) => (
        <a href={`/notes/${note.id}`} class="group block bg-deep-space/40 border border-muted-star/20 hover:border-muted-star/40 p-8 md:p-10 transition-all duration-300 animate-fade-up" style={`animation-delay: ${i * 50 + 100}ms`}>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start">
            {note.data.thumbnail && (
              <div class="md:col-span-3">
                <div class="w-32 md:w-full max-w-[160px] aspect-square overflow-hidden border border-muted-star/20 shrink-0 mx-auto">
                  <img src={note.data.thumbnail} alt="" class="w-full h-full object-cover brightness-[0.78] contrast-[1.08] saturate-[0.65] opacity-90 group-hover:brightness-100 group-hover:contrast-100 group-hover:saturate-100 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700" />
                </div>
              </div>
            )}
            <div class={note.data.thumbnail ? "md:col-span-9" : "md:col-span-12"}>
              <div class="font-mono text-[10px] md:text-xs text-muted-star/70 uppercase tracking-widest mb-3">
                {new Date(note.data.date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
              </div>
              <h3 class="font-display text-2xl text-starlight group-hover:text-solar-gold transition-colors mb-4 uppercase tracking-tight">
                {note.data.title}
              </h3>
              <p class="font-mono text-sm text-muted-star leading-relaxed mb-6">
                {note.data.description}
              </p>
              {note.data.tags && note.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {note.data.tags.map(tag => (
                    <span class="font-mono text-[10px] text-muted-star/60 border border-muted-star/20 px-2 py-0.5 uppercase tracking-widest">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
