        <p class="font-mono text-xs text-muted-star uppercase tracking-widest">Selected Works & Systems</p>
      </header>
      
      <div class="w-full aspect-[4/5] md:aspect-auto md:h-[500px] mb-16">
        <Map client:load projects={projects} />
      </div>

      {projects.length > 0 && (
        <div class="reveal">
          <a href={`/projects/${projects[0].slug || projects[0].id}`} class="group block border border-muted-star/20 bg-deep-space/40 hover:bg-nebula-surface/30 p-8 md:p-12 transition-all duration-300 relative overflow-hidden">
