---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/ui/Starfield.astro';
import Navbar from '../components/ui/Navbar.astro';
import Map from '../components/constellation/Map';
import Orbit from '../components/ui/Orbit';

import { getCollection } from 'astro:content';

const projectsData = await getCollection('projects');
// Map the collection to the expected format for Map.tsx
const projects = projectsData
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .map(p => ({
  id: p.id,
  slug: p.id,
  data: {
    title: p.data.title,
    domain: p.data.domain,
    description: p.data.description,
    tech: p.data.tech,
    date: p.data.date
  }
}));

const experiments = [
  { idNumber: '014', title: 'ESP32 RELAY CONTROL', domain: 'Hardware / ESP32', status: 'COMPLETED', outcome: 'Relay switching & GPIO control', evidence: 'CODE · SERIAL LOG' },
  { idNumber: '013', title: 'MQTT COMMUNICATION', domain: 'IoT / Networking', status: 'ONGOING', outcome: 'Publish/subscribe latency tests', evidence: 'SERIAL LOG' },
  { idNumber: '012', title: 'PLC FUNDAMENTALS', domain: 'Industrial Automation', status: 'ARCHIVED', outcome: 'Ladder logic implementation', evidence: 'SCHEMATIC' },
  { idNumber: '011', title: 'PHONE HARDWARE', domain: 'Electronics / Repair', status: 'COMPLETED', outcome: 'Screen & battery replacement', evidence: 'PHOTO' }
];

const notesData = await getCollection('notes');
const recentNotes = notesData.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()).slice(0, 3);

const seo = {
  title: 'Key Firdausi Al Farel | IoT & Software Engineer',
  description: 'Key Firdausi Al Farel is a software engineer interested in IoT, data, and systems that connect software with the physical world.',
  jsonLd: {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Key Firdausi Al Farel",
    "jobTitle": "IoT & Software Engineer",
    "url": "https://keyfarel.my.id",
    "sameAs": [
      "https://github.com/keyfarel",
      "https://www.linkedin.com/in/key-firdausi-alfarel-566616290/"
    ]
  }
};


---

<Layout seo={seo}>
  <Starfield />
  <Navbar />
  
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6">
    
    {/* HERO SECTION */}
    <section class="min-h-[100svh] flex flex-col justify-center pt-8 pb-32" id="hero">
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-16 xl:gap-8 items-center w-full">
        
        {/* Left Column: Human / Identity */}
        <div class="xl:col-span-6 flex flex-col justify-center">
          <div class="font-mono text-[10px] md:text-xs tracking-[0.2em] mb-12 xl:mb-[72px]">
            <div class="text-starlight mb-4 uppercase reveal" style="transition-delay: 100ms">Key Firdausi Al Farel</div>
            <div class="text-solar-gold uppercase reveal" style="transition-delay: 180ms">Software Engineer</div>
            <div class="text-muted-star reveal" style="transition-delay: 240ms">IoT · Data · Systems</div>
          </div>
          
          <h1 class="font-display font-normal text-[clamp(2.75rem,4vw,4.25rem)] leading-[0.95] tracking-[-0.045em] text-starlight mb-8 reveal" style="transition-delay: 300ms">
            PERSONAL<br />OBSERVATORY
          </h1>
          
          <p class="font-display text-[clamp(1rem,1.2vw,1.25rem)] text-muted-star max-w-lg uppercase tracking-[0.02em] leading-[1.7] mb-[40px] reveal" style="transition-delay: 450ms">
            I build systems<br class="hidden md:block"/> between software<br class="hidden md:block"/> and the physical world.
          </p>
          
          <div class="reveal" style="transition-delay: 600ms">
            <a href="#constellation" class="inline-flex items-center justify-center font-mono text-[13px] tracking-[0.2em] text-starlight border border-muted-star/30 hover:border-starlight hover:bg-starlight/5 h-[50px] px-[32px] transition-all duration-300 rounded-none hover:-translate-y-0.5 group">
              <span class="mr-2 opacity-50 group-hover:opacity-100 transition-opacity">[</span>
              EXPLORE MY WORK
              <span class="ml-2 opacity-50 group-hover:opacity-100 transition-opacity">]</span>
            </a>
          </div>
        </div>

        {/* Right Column: System / Observatory */}
        <div class="xl:col-span-6 hidden md:flex flex-col justify-center items-center xl:items-start xl:pl-12 reveal" style="transition-delay: 800ms">
          
          <div class="w-full max-w-[500px] relative group overflow-hidden rounded-sm bg-deep-space/40 shadow-2xl transition-all duration-700 hover:shadow-[0_0_40px_rgba(244,184,96,0.15)] -translate-y-8 xl:-translate-y-12">
            
            <img 
              src="/images/global/hero-photo.webp" 
              alt="Key Firdausi Al Farel Workspace" 
              class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.03] opacity-100 brightness-110 contrast-105"
            />
          </div>


      </div>
      </div>
    </section>

    {/* THE OBSERVER */}
    <section id="about" class="py-24 border-t border-muted-star/20 scroll-mt-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-12 items-center">
        
        {/* Left Column: Portrait */}
        <div class="lg:col-span-5 reveal hidden md:block">
          <div class="w-full aspect-[3/4] relative group overflow-hidden rounded-sm bg-deep-space/40 shadow-2xl transition-all duration-700 hover:shadow-[0_0_40px_rgba(244,184,96,0.15)]">
            <div class="absolute inset-0 bg-gradient-to-tr from-deep-space/40 via-transparent to-transparent z-10 pointer-events-none"></div>
            {/* Profile Image */}
            <img 
              src="/images/global/profile-photo.webp" 
              alt="Key Firdausi Al Farel Portrait" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03] opacity-100"
            />
          </div>
        </div>

        {/* Right Column: Text */}
        <div class="lg:col-span-7">
          <header class="mb-10 reveal">
            <h2 class="font-display font-light text-4xl text-starlight mb-2 uppercase">THE OBSERVER</h2>
            <p class="font-mono text-xs text-muted-star uppercase tracking-widest mt-2">Who I am</p>
          </header>
          
          <div class="prose prose-invert prose-p:font-sans prose-p:text-starlight prose-p:text-base prose-p:leading-relaxed max-w-none">
            <p class="reveal">
              I'm Key, a software engineer interested in systems that connect software with the physical world.
            </p>
            <p class="reveal">
              I like understanding how things work, then building something from that understanding.
            </p>
            <p class="text-muted-star mt-12 mb-4 reveal">
              My interests sit somewhere between:
            </p>
            <div class="font-mono text-solar-gold text-sm tracking-widest leading-loose flex flex-col gap-1 mt-4">
              <span class="reveal-x" style="transition-delay: 0ms">SOFTWARE</span>
              <span class="reveal-x" style="transition-delay: 80ms">IoT</span>
              <span class="reveal-x" style="transition-delay: 160ms">DATA</span>
              <span class="reveal-x" style="transition-delay: 240ms">SYSTEMS</span>
              <span class="reveal-x" style="transition-delay: 320ms">HARDWARE</span>
            </div>
          </div>
        </div>
        
